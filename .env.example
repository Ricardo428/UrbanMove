# Copia este archivo a .env (el .env no se sube al repositorio).
# Son valores de desarrollo local, no credenciales reales.
DB_USER=urbanmove
DB_PASSWORD=urbanmove

# Región de AWS para LocalStack.
AWS_REGION=us-east-1

# Clave de firma de los JWT (mínimo 32 caracteres). Valor de desarrollo local; en AWS Academy usa otra.
# Para generar una: openssl rand -base64 48
JWT_SECRET=clave-de-desarrollo-local-urbanmove-no-usar-en-aws

# Primer usuario ADMIN, que identity crea al arrancar si no existe (solo desarrollo local).
BOOTSTRAP_ADMIN_EMAIL=admin@urbanmove.local
BOOTSTRAP_ADMIN_PASSWORD=Admin-dev-12345
